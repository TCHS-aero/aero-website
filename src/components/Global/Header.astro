---
/**
 * Header.astro
 * ─────────────
 * Fixed navigation bar with:
 *  - Logo + wordmark
 *  - Desktop nav links (with active-state underline)
 *  - Mobile hamburger menu (animated → X, slide-open drawer)
 *  - JS for toggle / outside-click / Escape key / resize close
 *
 * To add a nav item: edit NAV_ITEMS in src/config/site.ts — changes
 * will appear here and in the Footer automatically.
 */
import { NAV_ITEMS } from '../../config/site';

const currentPath = Astro.url.pathname;
---

<header id="site-header">
  <div class="header-inner">
    <div class="container header-row">


      <a href="/" class="logo">
        <img
          src="/uploads/aero-logo.svg"
          alt="TCHS Aero logo"
          class="logo__img"
          width="80"
          height="32"
          onerror="this.style.display='none'"
        />
      </a>

 
      <nav class="desktop-nav" aria-label="Main navigation">
        <ul class="desktop-nav__list">
          {NAV_ITEMS.map(item => {
            const active = currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`desktop-nav__link ${active ? 'desktop-nav__link--active' : ''}`}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.text}
                </a>
              </li>
            );
          })}
        </ul>
        <a href="/sponsor" class="btn btn--ghost header-cta">Support Us</a>

        <!-- Search trigger -->
        <button id="search-trigger" class="search-trigger" aria-label="Search site">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
      </nav>


      <button
        id="mobile-toggle"
        class="mobile-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="bar bar--top"></span>
        <span class="bar bar--mid"></span>
        <span class="bar bar--bot"></span>
      </button>
    </div>


    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
      <div class="container">
        <ul class="mobile-nav__list">
          {NAV_ITEMS.map(item => {
            const active = currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`mobile-nav__link ${active ? 'mobile-nav__link--active' : ''}`}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.text}
                </a>
              </li>
            );
          })}
        </ul>
        <a href="/sponsor" class="btn btn--ghost mobile-nav__cta">Support Us</a>
      </div>
    </nav>
  </div>
</header>


<div class="header-spacer" aria-hidden="true"></div>

<!-- Search overlay -->
<div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="Site search">
  <div class="search-overlay__inner">
    <div class="search-box">
      <svg class="search-box__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search pages..."
        class="search-box__input"
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-close" class="search-close" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label="Search results"></ul>
    <p id="search-empty" class="search-empty" hidden>No results found.</p>
  </div>
</div>

<style>
  /* ── Fixed wrapper ── */
  #site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
  }

  .header-inner {
    background: var(--color-red);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .header-spacer {
    height: 4rem;
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .logo__img {
    height: 2rem;
    width: auto;
    object-fit: contain;
  }

  /* ── Desktop nav ── */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .desktop-nav { display: flex; }
  }

  .desktop-nav__list {
    display: flex;
    gap: 1.75rem;
  }

  .desktop-nav__link {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    position: relative;
    padding-bottom: 3px;
    transition: color var(--duration-fast) ease;
  }

  .desktop-nav__link::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0;
    height: 1px;
    background: var(--color-white);
    transition: width var(--duration-base) ease;
  }

  .desktop-nav__link:hover,
  .desktop-nav__link--active {
    color: var(--color-white);
  }

  .desktop-nav__link:hover::after,
  .desktop-nav__link--active::after {
    width: calc(86%);
  }

  .header-cta {
    margin-left: 0.5rem;
    padding: 0.5rem 1.25rem;
    font-size: var(--text-xs);
  }

  /* ── Mobile toggle button ── */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }

  @media (min-width: 768px) {
    .mobile-toggle { display: none; }
  }

  .bar {
    display: block;
    height: 1.5px;
    background: var(--color-white);
    transform-origin: center;
    transition:
      transform  var(--duration-base) ease,
      opacity    var(--duration-base) ease,
      width      var(--duration-base) ease;
  }

  .bar--top { width: 1.5rem; }
  .bar--mid { width: 1.5rem; }
  .bar--bot { width: 1rem; }

  /* Animate to X when open */
  .mobile-toggle[aria-expanded="true"] .bar--top {
    transform: rotate(45deg) translate(4px, 4px);
    width: 1.5rem;
  }
  .mobile-toggle[aria-expanded="true"] .bar--mid {
    opacity: 0;
    transform: scaleX(0);
  }
  .mobile-toggle[aria-expanded="true"] .bar--bot {
    transform: rotate(-45deg) translate(5px, -5px);
    width: 1.5rem;
    align-self: unset;
  }

  /* ── Mobile nav drawer ── */
  .mobile-nav {
    overflow: hidden;
    max-height: 0;
    border-top: 1px solid rgba(255, 255, 255, 0);
    transition:
      max-height   0.4s var(--ease-expo),
      border-color var(--duration-base) ease;
  }

  .mobile-nav.is-open {
    max-height: 32rem;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .mobile-nav__list {
    padding: 1rem 0;
  }

  .mobile-nav__link {
    display: block;
    padding: 0.75rem 0;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: color var(--duration-fast) ease;
  }
  .mobile-nav__link:hover,
  .mobile-nav__link--active {
    color: var(--color-white);
  }

  .mobile-nav__cta {
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
    width: 100%;
    text-align: center;
  }

  /* ── Search trigger button ── */
  .search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(255,255,255,0.75);
    border-radius: 4px;
    transition: color var(--duration-fast) ease;
    padding: 0;
  }
  .search-trigger:hover { color: var(--color-white); }

  /* ── Search overlay ── */
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 8rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .search-overlay.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .search-overlay__inner {
    width: 100%;
    max-width: 36rem;
    margin: 0 1.5rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-white);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .search-box__icon { color: var(--color-gray); flex-shrink: 0; }
  .search-box__input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1rem;
    font-family: var(--font-sans);
    color: var(--color-charcoal);
    background: transparent;
  }
  .search-box__input::placeholder { color: var(--color-gray); }
  .search-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-gray);
    display: flex;
    padding: 0;
    flex-shrink: 0;
  }
  .search-close:hover { color: var(--color-charcoal); }

  /* ── Results ── */
  .search-results {
    margin-top: 0.5rem;
    background: var(--color-white);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    max-height: 60vh;
    overflow-y: auto;
  }
  .search-results:empty { display: none; }

  .search-result {
    display: block;
    padding: 0.9rem 1.25rem;
    text-decoration: none;
    color: var(--color-charcoal);
    border-bottom: 1px solid var(--color-cream-dark);
    transition: background 0.15s ease;
  }
  .search-result:last-child { border-bottom: none; }
  .search-result:hover,
  .search-result.is-active { background: var(--color-cream); }
  .search-result__title {
    font-weight: 600;
    font-size: 0.95rem;
    display: block;
  }
  .search-result__desc {
    font-size: 0.82rem;
    color: var(--color-gray);
    margin-top: 0.15rem;
    display: block;
  }

  .search-empty {
    text-align: center;
    color: var(--color-gray);
    font-size: 0.9rem;
    padding: 1.25rem;
    background: var(--color-white);
    border-radius: 10px;
    margin-top: 0.5rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
  }
</style>

<script>
  const toggle   = document.getElementById('mobile-toggle') as HTMLButtonElement;
  const nav      = document.getElementById('mobile-nav')    as HTMLElement;
  const header   = document.getElementById('site-header')   as HTMLElement;

  let isOpen = false;

  function setOpen(value: boolean) {
    isOpen = value;
    nav.classList.toggle('is-open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
  }

  toggle.addEventListener('click', e => { e.stopPropagation(); setOpen(!isOpen); });

  document.addEventListener('click', e => {
    if (isOpen && !header.contains(e.target as Node)) setOpen(false);
  });

  nav.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && isOpen) setOpen(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isOpen) setOpen(false);
  });

  // ── Search ───────────────────────────────────────────────
  const PAGES = [
    { title: 'Home',         desc: 'Welcome to TCHS Aero',                       href: '/'            },
    { title: 'About Us',     desc: 'Learn about our club and mission',            href: '/about-us'    },
    { title: 'Our Journey',  desc: 'How we design, build, and fly our drones',   href: '/our-journey' },
    { title: 'The Team',     desc: 'Meet the students behind TCHS Aero',         href: '/the-team'    },
    { title: 'News',         desc: 'Latest updates and announcements',            href: '/news'        },
    { title: 'Contact',      desc: 'Get in touch with us',                        href: '/contact'     },
    { title: 'Sponsor Us',   desc: 'Support the team and our mission',            href: '/sponsor'     },
  ];

  const searchTrigger  = document.getElementById('search-trigger')  as HTMLButtonElement;
  const searchOverlay  = document.getElementById('search-overlay')  as HTMLElement;
  const searchInput    = document.getElementById('search-input')    as HTMLInputElement;
  const searchClose    = document.getElementById('search-close')    as HTMLButtonElement;
  const searchResults  = document.getElementById('search-results')  as HTMLUListElement;
  const searchEmpty    = document.getElementById('search-empty')    as HTMLParagraphElement;

  let activeIdx = -1;

  function openSearch() {
    searchOverlay.classList.add('is-open');
    searchInput.focus();
    document.body.style.overflow = 'hidden';
  }
  function closeSearch() {
    searchOverlay.classList.remove('is-open');
    searchInput.value = '';
    searchResults.innerHTML = '';
    searchEmpty.hidden = true;
    document.body.style.overflow = '';
    activeIdx = -1;
  }

  function renderResults(query: string) {
    const q = query.trim().toLowerCase();
    searchResults.innerHTML = '';
    searchEmpty.hidden = true;
    activeIdx = -1;

    if (!q) return;

    const matches = PAGES.filter(p =>
      p.title.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q)
    );

    if (!matches.length) { searchEmpty.hidden = false; return; }

    matches.forEach(p => {
      const li = document.createElement('li');
      li.role = 'option';
      const a = document.createElement('a');
      a.href = p.href;
      a.className = 'search-result';
      a.innerHTML = `<span class="search-result__title">${p.title}</span><span class="search-result__desc">${p.desc}</span>`;
      a.addEventListener('click', closeSearch);
      li.appendChild(a);
      searchResults.appendChild(li);
    });
  }

  searchTrigger.addEventListener('click', openSearch);
  searchClose.addEventListener('click', closeSearch);
  searchInput.addEventListener('input', e => renderResults((e.target as HTMLInputElement).value));

  searchOverlay.addEventListener('click', e => {
    if (e.target === searchOverlay) closeSearch();
  });

  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    if (e.key === 'Escape' && searchOverlay.classList.contains('is-open')) closeSearch();

    const items = searchResults.querySelectorAll<HTMLAnchorElement>('.search-result');
    if (!items.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIdx = Math.min(activeIdx + 1, items.length - 1);
      items.forEach((el, i) => el.classList.toggle('is-active', i === activeIdx));
      items[activeIdx]?.scrollIntoView({ block: 'nearest' });
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIdx = Math.max(activeIdx - 1, 0);
      items.forEach((el, i) => el.classList.toggle('is-active', i === activeIdx));
      items[activeIdx]?.scrollIntoView({ block: 'nearest' });
    }
    if (e.key === 'Enter' && activeIdx >= 0) {
      items[activeIdx]?.click();
    }
  });
</script>
