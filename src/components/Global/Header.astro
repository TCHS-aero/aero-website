---
import { NAV_ITEMS } from '../../config/site';
const currentPath = Astro.url.pathname;
---

<header id="site-header">
  <div class="header-inner">
    <div class="container header-row">

      <a href="/" class="logo">
        <img
          src="/uploads/aero-logo.svg"
          alt="TCHS Aero logo"
          class="logo__img"
          width="80"
          height="32"
          onerror="this.style.display='none'"
        />
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <ul class="desktop-nav__list">
          {NAV_ITEMS.map(item => {
            const active = currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`desktop-nav__link ${active ? 'desktop-nav__link--active' : ''}`}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.text}
                </a>
              </li>
            );
          })}
        </ul>

        <a href="/sponsor" class="btn btn--ghost header-cta">Support Us</a>

        <!-- Inline search -->
        <div class="header-search" id="header-search">
          <svg class="header-search__icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="Search..."
            class="header-search__input"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search pages"
            aria-expanded="false"
            aria-haspopup="listbox"
          />
          <ul id="search-results" class="search-dropdown" role="listbox" aria-label="Search results"></ul>
        </div>
      </nav>

      <button
        id="mobile-toggle"
        class="mobile-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="bar bar--top"></span>
        <span class="bar bar--mid"></span>
        <span class="bar bar--bot"></span>
      </button>
    </div>

    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
      <div class="container">
        <ul class="mobile-nav__list">
          {NAV_ITEMS.map(item => {
            const active = currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`mobile-nav__link ${active ? 'mobile-nav__link--active' : ''}`}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.text}
                </a>
              </li>
            );
          })}
        </ul>
        <a href="/sponsor" class="btn btn--ghost mobile-nav__cta">Support Us</a>
      </div>
    </nav>
  </div>
</header>

<div class="header-spacer" aria-hidden="true"></div>

<style>
  #site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
  }
  .header-inner {
    background: var(--color-red);
    box-shadow: 0 2px 12px rgba(0,0,0,0.2);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }
  .header-spacer { height: 4rem; }

  /* ── Logo ── */
  .logo { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
  .logo__img { height: 2rem; width: auto; object-fit: contain; }

  /* ── Desktop nav ── */
  .desktop-nav { display: none; align-items: center; gap: 1.5rem; }
  @media (min-width: 768px) { .desktop-nav { display: flex; } }

  .desktop-nav__list { display: flex; gap: 1.75rem; }

  .desktop-nav__link {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    position: relative;
    padding-bottom: 3px;
    transition: color var(--duration-fast) ease;
  }
  .desktop-nav__link::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 1px;
    background: var(--color-white);
    transition: width var(--duration-base) ease;
  }
  .desktop-nav__link:hover,
  .desktop-nav__link--active { color: var(--color-white); }
  .desktop-nav__link:hover::after,
  .desktop-nav__link--active::after { width: 86%; }

  .header-cta { padding: 0.5rem 1.25rem; font-size: var(--text-xs); }

  /* ── Inline search ── */
  .header-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
  }
  .header-search__icon {
    color: rgba(255,255,255,0.75);
    flex-shrink: 0;
    transition: color 0.2s ease;
  }
  .header-search:hover .header-search__icon { color: var(--color-white); }

  .header-search__input {
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.6);
    outline: none;
    background: transparent;
    color: var(--color-white);
    font-size: 0.78rem;
    font-family: var(--font-sans);
    width: 0;
    opacity: 0;
    padding: 0;
    transition: width 0.25s ease, opacity 0.25s ease, padding 0.25s ease;
    cursor: text;
  }
  .header-search__input::placeholder { color: rgba(255,255,255,0.5); }
  .header-search__input::-webkit-search-cancel-button { display: none; }

  /* when expanded */
  .header-search.is-expanded .header-search__input {
    width: 130px;
    opacity: 1;
    padding: 0.1rem 0;
  }

  /* ── Dropdown ── */
  .search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 160px;
    background: var(--color-red);
    border-radius: 0;
    border: none;
    overflow: hidden;
    display: none;
  }
  .search-dropdown.is-open { display: block; }

  .search-result,
  .search-result:visited,
  .search-result:link {
    display: block;
    padding: 0.6rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: #ffffff !important;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.12);
    transition: background 0.12s ease;
    white-space: nowrap;
  }
  .search-result:last-child { border-bottom: none; }
  .search-result:hover,
  .search-result.is-active { background: rgba(255,255,255,0.15); }

  /* ── Mobile toggle ── */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }
  @media (min-width: 768px) { .mobile-toggle { display: none; } }

  .bar {
    display: block;
    height: 1.5px;
    background: var(--color-white);
    transform-origin: center;
    transition: transform var(--duration-base) ease, opacity var(--duration-base) ease, width var(--duration-base) ease;
  }
  .bar--top { width: 1.5rem; }
  .bar--mid { width: 1.5rem; }
  .bar--bot { width: 1rem; }
  .mobile-toggle[aria-expanded="true"] .bar--top { transform: rotate(45deg) translate(4px,4px); width: 1.5rem; }
  .mobile-toggle[aria-expanded="true"] .bar--mid { opacity: 0; transform: scaleX(0); }
  .mobile-toggle[aria-expanded="true"] .bar--bot { transform: rotate(-45deg) translate(5px,-5px); width: 1.5rem; align-self: unset; }

  /* ── Mobile nav ── */
  .mobile-nav {
    overflow: hidden;
    max-height: 0;
    border-top: 1px solid rgba(255,255,255,0);
    transition: max-height 0.4s var(--ease-expo), border-color var(--duration-base) ease;
  }
  .mobile-nav.is-open { max-height: 32rem; border-color: rgba(255,255,255,0.12); }
  .mobile-nav__list { padding: 1rem 0; }
  .mobile-nav__link {
    display: block;
    padding: 0.75rem 0;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    transition: color var(--duration-fast) ease;
  }
  .mobile-nav__link:hover,
  .mobile-nav__link--active { color: var(--color-white); }
  .mobile-nav__cta { margin-top: 1.25rem; margin-bottom: 1.5rem; width: 100%; text-align: center; }
</style>

<script>
  // ── Mobile nav ──────────────────────────────────────────
  const toggle = document.getElementById('mobile-toggle') as HTMLButtonElement;
  const nav    = document.getElementById('mobile-nav')    as HTMLElement;
  const header = document.getElementById('site-header')   as HTMLElement;
  let isOpen   = false;

  function setOpen(value: boolean) {
    isOpen = value;
    nav.classList.toggle('is-open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
  }

  toggle.addEventListener('click', e => { e.stopPropagation(); setOpen(!isOpen); });
  document.addEventListener('click', e => { if (isOpen && !header.contains(e.target as Node)) setOpen(false); });
  nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && isOpen) setOpen(false); });
  window.addEventListener('resize', () => { if (window.innerWidth >= 768 && isOpen) setOpen(false); });

  // ── Inline search ────────────────────────────────────────
  const PAGES = [
    { title: 'Home',        href: '/'            },
    { title: 'About Us',    href: '/about-us'    },
    { title: 'Our Journey', href: '/our-journey' },
    { title: 'The Team',    href: '/the-team'    },
    { title: 'News',        href: '/news'        },
    { title: 'Contact',     href: '/contact'     },
    { title: 'Sponsor Us',  href: '/sponsor'     },
  ];

  const searchInput   = document.getElementById('search-input')   as HTMLInputElement;
  const searchResults = document.getElementById('search-results') as HTMLUListElement;
  let activeIdx = -1;

  function openDropdown() { searchResults.classList.add('is-open'); }
  function closeDropdown() {
    searchResults.classList.remove('is-open');
    activeIdx = -1;
  }

  function renderResults(query: string) {
    const q = query.trim().toLowerCase();
    searchResults.innerHTML = '';
    activeIdx = -1;

    if (!q) { closeDropdown(); return; }

    const matches = PAGES.filter(p => p.title.toLowerCase().includes(q));
    if (!matches.length) { closeDropdown(); return; }

    matches.forEach(p => {
      const li = document.createElement('li');
      const a  = document.createElement('a');
      a.href      = p.href;
      a.className = 'search-result';
      a.textContent = p.title;
      a.style.color = '#ffffff';
      a.style.fontFamily = 'var(--font-sans)';
      a.style.fontSize = 'var(--text-xs)';
      a.style.fontWeight = '500';
      a.style.letterSpacing = '0.18em';
      a.style.textTransform = 'uppercase';
      a.addEventListener('mousedown', e => e.preventDefault()); // keep focus on input
      a.addEventListener('click', () => { closeDropdown(); searchInput.value = ''; });
      li.appendChild(a);
      searchResults.appendChild(li);
    });

    openDropdown();
  }

  const searchWrap = document.getElementById('header-search') as HTMLElement;

  function expandSearch() {
    searchWrap.classList.add('is-expanded');
    searchInput.focus();
  }
  function collapseSearch() {
    searchWrap.classList.remove('is-expanded');
    searchInput.value = '';
    closeDropdown();
  }

  searchWrap.addEventListener('click', e => {
    if (!searchWrap.classList.contains('is-expanded')) expandSearch();
  });

  searchInput.addEventListener('input', e => renderResults((e.target as HTMLInputElement).value));
  searchInput.addEventListener('blur', () => setTimeout(() => {
    if (!searchInput.value) collapseSearch();
    else closeDropdown();
  }, 150));

  document.addEventListener('keydown', e => {
    if (!searchResults.classList.contains('is-open')) return;
    const items = searchResults.querySelectorAll<HTMLAnchorElement>('.search-result');
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIdx = Math.min(activeIdx + 1, items.length - 1);
      items.forEach((el, i) => el.classList.toggle('is-active', i === activeIdx));
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIdx = Math.max(activeIdx - 1, 0);
      items.forEach((el, i) => el.classList.toggle('is-active', i === activeIdx));
    }
    if (e.key === 'Enter' && activeIdx >= 0) items[activeIdx]?.click();
    if (e.key === 'Escape') { closeDropdown(); searchInput.blur(); }
  });
</script>
