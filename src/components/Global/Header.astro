---
import { NAV_ITEMS } from '../../config/site';
const currentPath = Astro.url.pathname;
---

<header id="site-header">
  <div class="header-inner">
    <div class="container header-row">
      <a href="/" class="logo">
        <img
          src="/uploads/aero-logo.svg"
          alt="TCHS Aero logo"
          class="logo__img"
          width="80"
          height="32"
          onerror="this.style.display='none'"
        />
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <ul class="desktop-nav__list">
          {NAV_ITEMS.map(item => {
            const active =
              currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));

            return (
              <li>
                <a
                  href={item.href}
                  class={`desktop-nav__link ${active ? 'desktop-nav__link--active' : ''}`}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.text}
                </a>
              </li>
            );
          })}
        </ul>

        <div class="header-search" id="header-search">
          <svg
            class="header-search__icon"
            id="search-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
            style="cursor:pointer"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>

          <input
            id="search-input"
            type="search"
            placeholder="Search..."
            class="header-search__input"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search site content"
          />

          <ul id="search-results" class="search-dropdown" role="listbox"></ul>
        </div>

        <a href="/sponsor" class="btn btn--ghost header-cta">Support Us</a>
      </nav>

      <button
        id="mobile-toggle"
        class="mobile-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="bar bar--top"></span>
        <span class="bar bar--mid"></span>
        <span class="bar bar--bot"></span>
      </button>
    </div>

    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
      <div class="container">
        <ul class="mobile-nav__list">
          {NAV_ITEMS.map(item => {
            const active =
              currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));

            return (
              <li>
                <a
                  href={item.href}
                  class={`mobile-nav__link ${active ? 'mobile-nav__link--active' : ''}`}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.text}
                </a>
              </li>
            );
          })}
        </ul>

        <a href="/sponsor" class="btn btn--ghost mobile-nav__cta">Support Us</a>
      </div>
    </nav>
  </div>
</header>

<div class="header-spacer" aria-hidden="true"></div>

<style>
  #site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .header-inner {
    background: var(--color-red);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
  }

  .header-row {
    display: flex;
    align-items: center;
    height: 4rem;
  }

  .header-spacer {
    height: 4rem;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .logo__img {
    height: 2rem;
    width: auto;
    object-fit: contain;
  }

  /* Desktop navigation.
     On mobile, display: contents lets the search sit beside the toggle. */
  .desktop-nav {
    display: contents;
  }

  .desktop-nav__list,
  .header-cta {
    display: none;
  }

  /* Search */
  .header-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    margin-right: 0.75rem;
    cursor: pointer;
  }

  .header-search__icon {
    color: rgba(255, 255, 255, 0.75);
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .header-search:hover .header-search__icon {
    color: var(--color-white);
  }

  .header-search__input {
    width: 0;
    opacity: 0;
    padding: 0;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
    outline: none;
    background: transparent;
    color: var(--color-white);
    font-size: 0.78rem;
    font-family: var(--font-sans);
    cursor: text;
    transition: width 0.25s ease, opacity 0.25s ease, padding 0.25s ease;
  }

  .header-search__input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .header-search__input::-webkit-search-cancel-button {
    display: none;
  }

  .header-search.is-expanded .header-search__input {
    width: 130px;
    opacity: 1;
    padding: 0.1rem 0;
  }

  /* Search results dropdown */
  .search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    display: none;
    min-width: 160px;
    overflow: hidden;
    background: var(--color-red);
    border: none;
    border-radius: 0;
  }

  .search-dropdown.is-open {
    display: block;
  }

  .search-result,
  .search-result:visited,
  .search-result:link {
    display: block;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff !important;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.12s ease;
    white-space: nowrap;
  }

  .search-result:last-child {
    border-bottom: none;
  }

  .search-result:hover,
  .search-result.is-active {
    background: rgba(255, 255, 255, 0.15);
  }

  /* Mobile menu toggle */
  .mobile-toggle {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.25rem;
    border: none;
    background: none;
    cursor: pointer;
  }

  .bar {
    display: block;
    height: 1.5px;
    background: var(--color-white);
    transform-origin: center;
    transition:
      transform var(--duration-base) ease,
      opacity var(--duration-base) ease,
      width var(--duration-base) ease;
  }

  .bar--top,
  .bar--mid {
    width: 1.5rem;
  }

  .bar--bot {
    width: 1rem;
  }

  .mobile-toggle[aria-expanded='true'] .bar--top {
    width: 1.5rem;
    transform: rotate(45deg) translate(4px, 4px);
  }

  .mobile-toggle[aria-expanded='true'] .bar--mid {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-toggle[aria-expanded='true'] .bar--bot {
    width: 1.5rem;
    align-self: unset;
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile navigation panel */
  .mobile-nav {
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0);
    transition:
      max-height 0.4s var(--ease-expo),
      border-color var(--duration-base) ease;
  }

  .mobile-nav.is-open {
    max-height: 32rem;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .mobile-nav__list {
    padding: 1rem 0;
  }

  .mobile-nav__link {
    display: block;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: color var(--duration-fast) ease;
  }

  .mobile-nav__link:hover,
  .mobile-nav__link--active {
    color: var(--color-white);
  }

  .mobile-nav__cta {
    width: 100%;
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  /* Desktop layout */
  @media (min-width: 1000px) {
    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-left: auto;
    }

    .desktop-nav__list {
      display: flex;
      gap: 1.75rem;
    }

    .header-cta {
      display: inline-flex;
      padding: 0.5rem 1.25rem;
      font-size: var(--text-xs);
    }

    .header-search {
      margin: 0;
    }

    .mobile-toggle {
      display: none;
    }
  }

  .desktop-nav__link {
    position: relative;
    padding-bottom: 3px;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: color var(--duration-fast) ease;
  }

  .desktop-nav__link::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-white);
    content: '';
    transition: width var(--duration-base) ease;
  }

  .desktop-nav__link:hover,
  .desktop-nav__link--active {
    color: var(--color-white);
  }

  .desktop-nav__link:hover::after,
  .desktop-nav__link--active::after {
    width: 86%;
  }
</style>

<script>
  // Mobile navigation
  const toggle = document.getElementById('mobile-toggle') as HTMLButtonElement;
  const nav = document.getElementById('mobile-nav') as HTMLElement;
  const header = document.getElementById('site-header') as HTMLElement;
  let isOpen = false;

  function setOpen(value: boolean) {
    isOpen = value;
    nav.classList.toggle('is-open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute(
      'aria-label',
      isOpen ? 'Close navigation menu' : 'Open navigation menu'
    );
  }

  toggle.addEventListener('click', event => {
    event.stopPropagation();
    setOpen(!isOpen);
  });

  document.addEventListener('click', event => {
    if (isOpen && !header.contains(event.target as Node)) {
      setOpen(false);
    }
  });

  nav.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && isOpen) {
      setOpen(false);
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1000 && isOpen) {
      setOpen(false);
    }
  });

  // Pagefind search
  const searchWrap = document.getElementById('header-search') as HTMLElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchResults = document.getElementById('search-results') as HTMLUListElement;
  let pagefind: any = null;
  let activeIdx = -1;

  async function loadPagefind() {
    if (pagefind) return;

    try {
      // @ts-ignore
      const pagefindPath = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pagefindPath);
      await pagefind.init();
    } catch (error) {
      console.warn('Pagefind not available in dev mode');
    }
  }

  function expandSearch() {
    searchWrap.classList.add('is-expanded');
    searchInput.focus();
    loadPagefind();
  }

  function closeDropdown() {
    searchResults.classList.remove('is-open');
    searchResults.innerHTML = '';
    activeIdx = -1;
  }

  function collapseSearch() {
    searchWrap.classList.remove('is-expanded');
    searchInput.value = '';
    closeDropdown();
  }

  searchWrap.addEventListener('click', () => {
    if (!searchWrap.classList.contains('is-expanded')) {
      expandSearch();
    }
  });

  searchInput.addEventListener('blur', () => {
    setTimeout(() => {
      if (!searchInput.value) {
        collapseSearch();
      } else {
        closeDropdown();
      }
    }, 200);
  });

  searchInput.addEventListener('input', async event => {
    const query = (event.target as HTMLInputElement).value.trim();
    searchResults.innerHTML = '';
    activeIdx = -1;

    if (!query || !pagefind) {
      closeDropdown();
      return;
    }

    const results = await pagefind.search(query);
    const topResults = await Promise.all(
      results.results.slice(0, 6).map((result: any) => result.data())
    );

    if (!topResults.length) {
      closeDropdown();
      return;
    }

    topResults.forEach((result: any) => {
      const li = document.createElement('li');
      const link = document.createElement('a');

      link.href = result.url;
      link.className = 'search-result';
      link.style.color = '#ffffff';
      link.style.fontFamily = 'var(--font-sans)';
      link.style.fontSize = 'var(--text-xs)';
      link.style.fontWeight = '500';
      link.style.letterSpacing = '0.18em';
      link.style.textTransform = 'uppercase';

      const title = document.createElement('span');
      title.className = 'search-result__title';
      title.style.color = '#ffffff';
      title.textContent = result.meta?.title || result.url;

      const excerpt = document.createElement('span');
      excerpt.className = 'search-result__excerpt';
      excerpt.style.color = 'rgba(255,255,255,0.65)';
      excerpt.style.fontSize = '0.72rem';
      excerpt.style.letterSpacing = '0';
      excerpt.style.textTransform = 'none';
      excerpt.style.fontWeight = '400';
      excerpt.style.display = 'block';
      excerpt.style.marginTop = '2px';
      excerpt.style.whiteSpace = 'normal';
      excerpt.style.lineHeight = '1.4';

      const temp = document.createElement('div');
      temp.innerHTML = result.excerpt || '';
      excerpt.textContent = temp.textContent || '';

      link.appendChild(title);
      link.appendChild(excerpt);

      link.addEventListener('mousedown', event => event.preventDefault());
      link.addEventListener('click', () => {
        closeDropdown();
        searchInput.value = '';
        collapseSearch();
      });

      li.appendChild(link);
      searchResults.appendChild(li);
    });

    searchResults.classList.add('is-open');
  });

  document.addEventListener('keydown', event => {
    if (!searchResults.classList.contains('is-open')) return;

    const items =
      searchResults.querySelectorAll<HTMLAnchorElement>('.search-result');

    if (event.key === 'ArrowDown') {
      event.preventDefault();
      activeIdx = Math.min(activeIdx + 1, items.length - 1);
      items.forEach((item, index) => {
        item.classList.toggle('is-active', index === activeIdx);
      });
    }

    if (event.key === 'ArrowUp') {
      event.preventDefault();
      activeIdx = Math.max(activeIdx - 1, 0);
      items.forEach((item, index) => {
        item.classList.toggle('is-active', index === activeIdx);
      });
    }

    if (event.key === 'Enter' && activeIdx >= 0) {
      items[activeIdx]?.click();
    }

    if (event.key === 'Escape') {
      collapseSearch();
    }
  });
</script>
